# Runtime identity (required; one of dev, staging, prod)
ENVIRONMENT=dev
# Required outside development; use distinct immutable IDs for testnet and prod.
DEPLOYMENT_ID=local-dev

# Required secrets. Use local-only credentials here; never commit real values.
BOT_TOKEN=replace_me
OPENAI_API_KEY=replace_me
REPORT_TOKEN_SECRET=replace_me_with_at_least_32_random_characters

# Required infrastructure
DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/love_yourself
# Optional only in dev; required in staging and prod.
REDIS_URL=redis://127.0.0.1:6379/0

# Public runtime addresses
APP_BASE_URL=http://127.0.0.1:8000
BOT_USERNAME=local_dev_bot
PORT=8000

# Optional operations and model selection
ADMIN_IDS=
TZ=Europe/Kyiv
MODEL=gpt-5-mini
PLAN_MODEL=gpt-4.1-mini
COACH_MODEL=gpt-5.1
MAX_TOKENS=300
TEMPERATURE=0.7
