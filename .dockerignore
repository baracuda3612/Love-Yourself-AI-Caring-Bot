# Deny by default. The release image needs only runtime code and its lock file.
**
!app/
!app/**
!alembic.ini
!migrations/
!migrations/alembic/
!migrations/alembic/env.py
!migrations/alembic/script.py.mako
!migrations/alembic/versions/
!migrations/alembic/versions/*.py
!requirements.txt
!resource/
!resource/assets/
!resource/assets/content_library/
!resource/assets/content_library/tasks/
!resource/assets/content_library/tasks/burnout_combined_content_library.json
!resource/assets/content_library/media/
!resource/assets/content_library/media/manifest.json
!resource/assets/content_library/media/breathing_sigh.gif
!resource/assets/content_library/media/pmr_fist.gif
!resource/assets/content_library/media/cold_water_face.gif
!scripts/
!scripts/load_content_library.py
!resource/assets/plan/
!resource/assets/plan/plan_context_template.yaml
!resource/assets/product/
!resource/assets/product/conceptual_map_en.md
!resource/assets/ux/
!resource/assets/ux/pulse_quotes.json
!resource/assets/ux/trigger_messages.json

# Keep local artifacts and credential-shaped files excluded even under app/.
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
**/.env
**/.env.*
**/*secret*
**/*credential*
**/.DS_Store
